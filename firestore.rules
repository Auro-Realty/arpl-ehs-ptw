rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'super-admin' ||
        request.auth.token.email == 'ehs.superadmin@aurorealty.com' ||
        (userDocExists() && userDocRole() == 'super-admin')
      );
    }

    function isAnyProjectAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role in ['project-admin', 'site-admin', 'admin'] ||
        (userDocExists() && userDocRole() in ['project-admin', 'site-admin', 'admin'])
      );
    }

    function isProjectAdmin(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.role in ['project-admin', 'site-admin', 'admin'] && request.auth.token.projectId == projectId) ||
        (userDocExists() && userDocRole() in ['project-admin', 'site-admin', 'admin'] &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectId == projectId)
      );
    }

    function hasProjectAccess(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.projectId == projectId ||
        (request.auth.token.projectIds != null && projectId in request.auth.token.projectIds) ||
        (userDocExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectId == projectId)
      );
    }

    function isEhsRole(projectId) {
      return hasProjectAccess(projectId) && (
        request.auth.token.role in ['ehs-manager', 'ehs-officer'] ||
        (userDocExists() && userDocRole() in ['ehs-manager', 'ehs-officer'])
      );
    }

    // Projects Collection: Geolocation, Locations, Workflows & Towers configuration
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isAnyProjectAdmin();
      allow delete: if isSuperAdmin();
    }

    // Users Collection: User directory and role/location/workflow binding
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || isAnyProjectAdmin() || (
        isAuthenticated() && request.auth.uid == userId && (
          request.auth.token.email == 'ehs.superadmin@aurorealty.com' ||
          !('role' in request.resource.data) ||
          request.resource.data.role == 'site-supervisor'
        )
      );
      allow update: if isSuperAdmin() || isAnyProjectAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('uiRole', null) == resource.data.get('uiRole', null) &&
        request.resource.data.get('projectId', null) == resource.data.get('projectId', null)
      );
      allow delete: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // Project Admins Directory
    match /project_admins/{adminId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // Site Personnel Directory (Location & Workflow Tagged Roles)
    match /site_personnel/{staffId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // Project Custom Roles Directory
    match /project_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // Contractors Directory
    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // Permits Collection
    match /permits/{permitId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        !('projectId' in resource.data) ||
        hasProjectAccess(resource.data.projectId)
      );
      allow create: if isAuthenticated() && (
        !('projectId' in request.resource.data) ||
        hasProjectAccess(request.resource.data.projectId)
      );
      allow update: if isAuthenticated() && (
        !('projectId' in resource.data) ||
        hasProjectAccess(resource.data.projectId)
      ) && (
        !(resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true) ||
        request.resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true
      );
      allow delete: if false; // Permits can never be deleted (DPDP Act audit requirement)

      // Subcollection: Immutable Activity Log (Append-only audit trail)
      match /activity_log/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false; // Tamper-proof guarantee
      }

      // Subcollection: Safety Observations
      match /observations/{obsId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if false;
      }
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // System Counters (Atomic sequential numbers)
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed exclusively by Cloud Functions transaction
    }

    // Audit Logs Collection (Immutable statutory audit trail)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Tamper-proof immutable ledger
    }

    // Dynamic Roles & Permissions Governance
    match /roles_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Multi-stage Approval Workflows Configuration
    match /approval_workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAnyProjectAdmin();
    }

    // System Settings & Statutory Retention Policies
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Explicit Default-Deny Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
