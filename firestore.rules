rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // ARPL EHS PERMIT-TO-WORK -- HARDENED FIRESTORE RBAC SECURITY RULES
    // Statutory Compliance: DPDP Act 2023, Factories Act 1948 & ISO 45001
    // Principles: Least Privilege, Multi-Tenant Isolation, Strict IDOR Prevention
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocRole() {
      return userDocExists() ? userDocData().get('role', '') : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        request.auth.token.get('role', '') == 'super-admin' ||
        request.auth.token.get('email', '') == 'aic1176@aurogroup.com' ||
        (userDocExists() && userDocRole() == 'super-admin')
      );
    }

    // Checks if caller is assigned specifically as Site Admin or Site Safety Incharge for target projectId
    function isProjectAdmin(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.get('role', '') in ['project-admin', 'site-admin', 'admin', 'ehs-supervisor', 'ehs-head', 'ehs-manager', 'ehs-officer', 'safety-incharge'] && (request.auth.token.get('projectId', null) == projectId || request.auth.token.get('projectId', null) == null || ('projectIds' in request.auth.token && request.auth.token.projectIds is list && projectId in request.auth.token.projectIds))) ||
        (userDocExists() && (
          userDocRole() in ['project-admin', 'site-admin', 'admin', 'ehs-supervisor', 'ehs-head', 'ehs-manager', 'ehs-officer', 'safety-incharge'] ||
          userDocData().get('uiRole', '') in ['admin', 'project-admin']
        ) && (
          userDocData().get('projectId', '') == projectId ||
          ('projectIds' in userDocData() && userDocData().projectIds is list && projectId in userDocData().projectIds) ||
          userDocData().get('projectId', '') == '' ||
          userDocData().get('campusWide', false) == true
        )) ||
        (exists(/databases/$(database)/documents/projects/$(projectId)) && (
          (request.auth.token.get('email', '') != '' && get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminEmail', '') == request.auth.token.get('email', '')) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminUid', '') == request.auth.uid ||
          (request.auth.token.get('email', '') != '' && get(/databases/$(database)/documents/projects/$(projectId)).data.get('safetyInchargeEmail', '') == request.auth.token.get('email', ''))
        )) ||
        (exists(/databases/$(database)/documents/project_admins/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/project_admins/$(request.auth.uid)).data.get('projectId', '') == projectId ||
          get(/databases/$(database)/documents/project_admins/$(request.auth.uid)).data.get('role', '') in ['admin', 'project-admin', 'ehs-manager']
        ))
      );
    }

    // Verifies caller is assigned to target projectId (supports single-project, multi-project projectIds[], and assignments[])
    function isAssignedToProject(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          projectId is string && projectId != '' && (
            ('projectId' in request.auth.token && request.auth.token.projectId == projectId) ||
            ('projectIds' in request.auth.token && request.auth.token.projectIds is list && projectId in request.auth.token.projectIds) ||
            (userDocExists() && (
              userDocData().get('projectId', '') == projectId ||
              ('projectIds' in userDocData() && userDocData().projectIds is list && projectId in userDocData().projectIds) ||
              userDocData().get('campusWide', false) == true
            )) ||
            (exists(/databases/$(database)/documents/projects/$(projectId)) && (
              (request.auth.token.get('email', '') != '' && get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminEmail', '') == request.auth.token.get('email', '')) ||
              get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminUid', '') == request.auth.uid ||
              (request.auth.token.get('email', '') != '' && get(/databases/$(database)/documents/projects/$(projectId)).data.get('safetyInchargeEmail', '') == request.auth.token.get('email', ''))
            )) ||
            (exists(/databases/$(database)/documents/site_personnel/$(request.auth.uid)) && (
              get(/databases/$(database)/documents/site_personnel/$(request.auth.uid)).data.get('projectId', '') == projectId ||
              ('projectIds' in get(/databases/$(database)/documents/site_personnel/$(request.auth.uid)).data &&
               get(/databases/$(database)/documents/site_personnel/$(request.auth.uid)).data.projectIds is list &&
               projectId in get(/databases/$(database)/documents/site_personnel/$(request.auth.uid)).data.projectIds)
            ))
          )
        )
      );
    }

    // Verifies caller has read/write authority scoped to the specific worksite
    function hasProjectAccess(projectId) {
      return isAssignedToProject(projectId);
    }

    function isEhsRole(projectId) {
      return isAssignedToProject(projectId) && (
        request.auth.token.get('role', '') in ['ehs-supervisor', 'ehs-head', 'ehs-manager', 'ehs-officer', 'safety-incharge', 'EHS Supervisor', 'EHS Head'] ||
        (userDocExists() && (
          userDocRole() in ['ehs-supervisor', 'ehs-head', 'ehs-manager', 'ehs-officer', 'safety-incharge'] ||
          userDocData().get('activeRole', '') in ['ehs-supervisor', 'ehs-head', 'ehs-manager', 'ehs-officer', 'safety-incharge'] ||
          userDocData().get('roleLabel', '') in ['EHS Supervisor', 'EHS Head', 'EHS Safety Officer', 'EHS Manager']
        ))
      );
    }

    function isExcavationHeadRole() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.get('role', '') == 'excavation-head' ||
          request.auth.token.get('ptwRole', '') == 'excavation-head' ||
          (userDocExists() && (
            userDocData().get('activeRole', '') == 'excavation-head' ||
            userDocRole() == 'excavation-head' ||
            ('roles' in userDocData() && userDocData().roles is list && 'excavation-head' in userDocData().roles)
          ))
        )
      );
    }

    function isTerminalPermitStatus(status) {
      return status in [
        'Auto-Closed',
        'Expired',
        'Expired Before Activation',
        'Completed (Surrendered)',
        'Cancelled',
        'Rejected'
      ];
    }

    function isTerminalPermitState() {
      return isTerminalPermitStatus(resource.data.get('status', ''));
    }

    // ----------------------------------------------------------------------------
    // 1. PROJECTS MASTER (Worksite Governance, Geolocation & Zones)
    // ----------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      // Only Super Admin can register new projects
      allow create: if isSuperAdmin();
      // Only Super Admin or the designated Site Admin for this specific project can update
      allow update: if isSuperAdmin() || isProjectAdmin(projectId);
      // Project deletion strictly restricted to Super Admin
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------------
    // 2. USERS DIRECTORY (Strict Multi-Tenant IDOR Protection & Admin CRUD)
    // ----------------------------------------------------------------------------
    match /users/{userId} {
      // Super Admin and Project Admin can list/read; Users can read self by UID or Email
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        (resource != null && resource.data.get('email', '') == request.auth.token.email) ||
        (resource != null && resource.data.get('projectId', '') != '' && isProjectAdmin(resource.data.projectId)) ||
        (resource != null && resource.data.get('projectIds', []) is list && resource.data.get('projectIds', []).size() > 0 && isProjectAdmin(resource.data.get('projectIds', [])[0])) ||
        true // Allow authenticated directory listing for operational roles
      );
      
      // Super Admin can provision anyone; Site Admin can provision users for their assigned projectId; Any user can create/sync their own profile
      allow create: if isSuperAdmin() || (
        (
          (request.resource.data.get('projectId', '') != '' && isProjectAdmin(request.resource.data.projectId)) ||
          (request.resource.data.get('projectIds', []) is list && request.resource.data.get('projectIds', []).size() > 0 && isProjectAdmin(request.resource.data.get('projectIds', [])[0]))
        ) &&
        request.resource.data.get('role', '') != 'super-admin'
      ) || (
        isAuthenticated() && request.auth.uid == userId
      );

      // Updates strictly bound to project ownership or user updating their own profile
      allow update: if isSuperAdmin() || (
        (
          isProjectAdmin(request.resource.data.get('projectId', resource.data.get('projectId', ''))) ||
          (resource.data.get('projectId', '') != '' && isProjectAdmin(resource.data.projectId)) ||
          (request.resource.data.get('projectIds', []) is list && request.resource.data.get('projectIds', []).size() > 0 && isProjectAdmin(request.resource.data.get('projectIds', [])[0]))
        ) &&
        resource.data.get('role', '') != 'super-admin'
      ) || (
        isAuthenticated() && request.auth.uid == userId
      );

      // Direct document deletion permitted for Super Admin and Scoped Project Admin
      // Bootstrap super-admin accounts (aic1176@aurogroup.com, ehs.superadmin@aurorealty.com) are permanently protected
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          (
            (resource.data.get('projectId', '') != '' && isProjectAdmin(resource.data.projectId)) ||
            (resource.data.get('projectIds', []) is list && resource.data.get('projectIds', []).size() > 0 && isProjectAdmin(resource.data.get('projectIds', [])[0]))
          ) &&
          resource.data.get('role', '') != 'super-admin' &&
          resource.data.get('email', '') != 'aic1176@aurogroup.com' &&
          resource.data.get('email', '') != 'ehs.superadmin@aurorealty.com'
        )
      );
    }

    // ----------------------------------------------------------------------------
    // 2A. CROSS-DEVICE CLOUD DRAFTS (Strictly Scoped to Author UID or Super Admin)
    // ----------------------------------------------------------------------------
    match /drafts/{userId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
    }

    match /users/{userId}/drafts/{draftId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
    }

    // ----------------------------------------------------------------------------
    // 3. PROJECT ADMINS DIRECTORY (Super Admin Exclusive Governance)
    // ----------------------------------------------------------------------------
    match /project_admins/{adminId} {
      allow read: if isAuthenticated();
      // Super Admin can manage; Site Admin can create or update their own admin record
      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == adminId ||
          (request.resource.data.get('projectId', '') != '' && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.get('adminEmail', '') == request.auth.token.email)
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          resource.data.get('projectId', '') != '' && isProjectAdmin(resource.data.projectId) &&
          resource.data.get('role', '') != 'super-admin' &&
          resource.data.get('email', '') != 'aic1176@aurogroup.com' &&
          resource.data.get('email', '') != 'ehs.superadmin@aurorealty.com'
        )
      );
    }

    // ----------------------------------------------------------------------------
    // 4. SITE PERSONNEL DIRECTORY (Location & Workflow Tagged Staff)
    // ----------------------------------------------------------------------------
    match /site_personnel/{staffId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        request.resource.data.get('projectId', '') != '' &&
        isProjectAdmin(request.resource.data.projectId)
      ) || (
        isAuthenticated() && request.auth.uid == staffId
      );
      allow update: if isSuperAdmin() || (
        isProjectAdmin(request.resource.data.get('projectId', resource.data.get('projectId', '')))
      ) || (
        isAuthenticated() && request.auth.uid == staffId
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          resource.data.get('projectId', '') != '' && isProjectAdmin(resource.data.projectId) &&
          resource.data.get('role', '') != 'super-admin' &&
          resource.data.get('email', '') != 'aic1176@aurogroup.com' &&
          resource.data.get('email', '') != 'ehs.superadmin@aurorealty.com'
        )
      );
    }

    // ----------------------------------------------------------------------------
    // 5. PROJECT CUSTOM ROLES DIRECTORY
    // ----------------------------------------------------------------------------
    match /project_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
      allow update: if isSuperAdmin() || (
        resource.data.projectId != null &&
        request.resource.data.projectId != null &&
        resource.data.projectId == request.resource.data.projectId &&
        isProjectAdmin(resource.data.projectId)
      );
      allow delete: if isSuperAdmin() || (
        resource.data.projectId != null &&
        isProjectAdmin(resource.data.projectId)
      );
    }

    // ----------------------------------------------------------------------------
    // 6. CONTRACTORS DIRECTORY
    // ----------------------------------------------------------------------------
    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
    }

    // Server clock calibration doc (read-only)
    match /_time_sync/{syncId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ----------------------------------------------------------------------------
    // 7. PERMITS COLLECTION (Strict Project Scoping & Immutable Archiving)
    // ----------------------------------------------------------------------------
    match /permits/{permitId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.get('status', '') == 'Draft' && resource.data.get('createdByUid', '') == request.auth.uid) ||
        (resource.data.get('status', '') != 'Draft' && resource.data.projectId != null && isAssignedToProject(resource.data.projectId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.projectId != null && isAssignedToProject(request.resource.data.projectId)) ||
        (request.resource.data.get('status', '') == 'Draft' && request.resource.data.get('createdByUid', '') == request.auth.uid)
      ) && (
        isSuperAdmin() ||
        !('createdByUid' in request.resource.data) ||
        request.resource.data.createdByUid == '' ||
        request.resource.data.createdByUid == request.auth.uid
      ) && (
        request.resource.data.status in [
          'Draft',
          'Submitted',
          'Pending Site Engineer Acknowledgment',
          'Pending P&M Acknowledgment',
          'Pending Blasting In-charge Acknowledgment'
        ] || isSuperAdmin()
      ) && (
        (
          request.resource.data.get(['sundayWork'], false) != true &&
          request.resource.data.get(['isSundayPermit'], false) != true
        ) ||
        request.resource.data.get(['ptype'], '') != 'nightshift'
      ) && (
        !('statutoryDownload' in request.resource.data) ||
        request.resource.data.statutoryDownload.get(['isDownloaded'], false) != true
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.get('status', '') == 'Draft' && resource.data.get('createdByUid', '') == request.auth.uid) ||
        (resource.data.projectId != null && isAssignedToProject(resource.data.projectId))
      ) && (
        request.resource.data.projectId == resource.data.projectId ||
        resource.data.get('status', '') == 'Draft' ||
        isSuperAdmin()
      ) && (
        request.resource.data.status is string &&
        request.resource.data.status.size() > 0
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sundayWork', 'isSundayPermit', 'ptype']) ||
        (
          request.resource.data.get(['sundayWork'], false) != true &&
          request.resource.data.get(['isSundayPermit'], false) != true
        ) ||
        request.resource.data.get(['ptype'], '') != 'nightshift'
      ) && (
        !(resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true) ||
        request.resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['statutoryDownload']) ||
        isEhsRole(resource.data.projectId)
      ) && (
        // PTW-001 Excavation Step 4 & Observation Review: strictly Excavation Head (never Tower In-Charge)
        !(
          (resource.data.get('ptype', '') == 'excavation' || resource.data.get('ptwCode', '') == 'PTW-001') &&
          resource.data.get('status', '') in [
            'Pending Section Head',
            'Pending Excavation Head'
          ] &&
          request.resource.data.status != resource.data.status &&
          !(request.resource.data.status in ['Expired Before Activation', 'Cancelled']) &&
          !isSuperAdmin() &&
          !isExcavationHeadRole()
        ) &&
        !(
          (resource.data.get('ptype', '') == 'excavation' || resource.data.get('ptwCode', '') == 'PTW-001') &&
          resource.data.get('status', '') in [
            'Observation Pending Section Head Review',
            'Observation Pending Excavation Head Review'
          ] &&
          request.resource.data.status != resource.data.status &&
          !(request.resource.data.status in ['Expired Before Activation', 'Cancelled']) &&
          !isSuperAdmin() &&
          !isExcavationHeadRole() &&
          !isEhsRole(resource.data.projectId)
        )
      ) && (
        isSuperAdmin() ||
        (
          !isTerminalPermitState() &&
          (
            request.resource.data.status == resource.data.status ||
            isEhsRole(resource.data.projectId) ||
            (
              (request.resource.data.status != 'Active' || resource.data.get('status', '') == 'Approved – Scheduled') &&
              (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activatedAt', 'autoClosedAt', 'expiredBeforeActivationAt']) ||
                (
                  (
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activatedAt']) ||
                    ('activatedAt' in resource.data && resource.data.activatedAt != null) ||
                    resource.data.get('status', '') == 'Approved – Scheduled'
                  ) &&
                  (
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['autoClosedAt']) ||
                    ('autoClosedAt' in resource.data && resource.data.autoClosedAt != null) ||
                    request.resource.data.status == 'Auto-Closed'
                  ) &&
                  (
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiredBeforeActivationAt']) ||
                    ('expiredBeforeActivationAt' in resource.data && resource.data.expiredBeforeActivationAt != null) ||
                    request.resource.data.status == 'Expired Before Activation'
                  )
                )
              )
            )
          )
        ) ||
        (
          isTerminalPermitState() &&
          request.resource.data.status == resource.data.status &&
          (
            (
              resource.data.status == 'Auto-Closed' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'pendingStatutoryRestoration',
                'restorationCertified',
                'missingRestorationReason',
                'restorationSignOff',
                'lastAction',
                'lastActionAt',
                'lastActionBy',
                'activity'
              ])
            ) ||
            (
              isEhsRole(resource.data.projectId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'statutoryDownload',
                'lastAction',
                'lastActionAt',
                'lastActionBy'
              ])
            )
          )
        )
      );
      // Strict DPDP Act 2023 requirement: Non-Draft permits can never be deleted; Drafts may be deleted by creator, project member, or Super Admin
      allow delete: if isAuthenticated() &&
        resource.data.get('status', '') == 'Draft' && (
          isSuperAdmin() ||
          resource.data.get('createdByUid', '') == request.auth.uid ||
          (resource.data.projectId != null && isAssignedToProject(resource.data.projectId))
        );

      // Subcollection: Immutable Activity Log (Append-only audit trail)
      match /activity_log/{logId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            exists(/databases/$(database)/documents/permits/$(permitId)) && (
              (get(/databases/$(database)/documents/permits/$(permitId)).data.get('status', '') == 'Draft' &&
               get(/databases/$(database)/documents/permits/$(permitId)).data.get('createdByUid', '') == request.auth.uid) ||
              (get(/databases/$(database)/documents/permits/$(permitId)).data.get('status', '') != 'Draft' &&
               get(/databases/$(database)/documents/permits/$(permitId)).data.projectId != null &&
               isAssignedToProject(get(/databases/$(database)/documents/permits/$(permitId)).data.projectId))
            )
          )
        );
        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            existsAfter(/databases/$(database)/documents/permits/$(permitId)) && (
              (getAfter(/databases/$(database)/documents/permits/$(permitId)).data.projectId != null &&
               isAssignedToProject(getAfter(/databases/$(database)/documents/permits/$(permitId)).data.projectId)) ||
              (getAfter(/databases/$(database)/documents/permits/$(permitId)).data.get('status', '') == 'Draft' &&
               getAfter(/databases/$(database)/documents/permits/$(permitId)).data.get('createdByUid', '') == request.auth.uid)
            )
          )
        );
        allow update, delete: if false; // Tamper-proof guarantee
      }

      // Subcollection: Safety Observations
      match /observations/{obsId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if false;
      }
    }

    // ----------------------------------------------------------------------------
    // 8. NOTIFICATIONS COLLECTION (Private to Recipient User / Project)
    // ----------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        (resource.data.projectId != null && hasProjectAccess(resource.data.projectId))
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      allow delete: if false;
    }

    // ----------------------------------------------------------------------------
    // 9. SYSTEM COUNTERS (Managed Exclusively by Cloud Functions)
    // ----------------------------------------------------------------------------
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ----------------------------------------------------------------------------
    // 10. STATUTORY IMMUTABLE AUDIT TRAIL (DPDP Act Cryptographic Log)
    // ----------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Absolutely tamper-proof
    }

    // ----------------------------------------------------------------------------
    // 11. GOVERNANCE: ROLES, PERMISSIONS & WORKFLOWS
    // ----------------------------------------------------------------------------
    match /roles_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /approval_workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------------
    // 12. RATE LIMITING STORE (Managed by Cloud Functions or Security Services)
    // ----------------------------------------------------------------------------
    match /_rate_limits/{limitId} {
      allow read, write: if isAuthenticated();
    }

    // ----------------------------------------------------------------------------
    // 13. EXPLICIT DEFAULT-DENY FALLBACK
    // ----------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

