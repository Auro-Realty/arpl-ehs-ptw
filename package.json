{
  "name": "arpl-ehs-permit-to-work",
  "version": "3.0.0",
  "description": "Enterprise-Grade Digital Safety Governance & Permit-to-Work System for Construction Operations",
  "main": "server.js",
  "scripts": {
    "sync": "npm run sync:public",
    "sync:public": "node -e \"const fs=require('fs'),path=require('path');fs.mkdirSync('public',{recursive:true});for(const f of ['index.html','ptw_swimlanes.html','config.projects.json','firebase-config.js','404.html','auro-realty-logo.png','auro-realty-gradient.png','pptxgen.bundle.js']){if(fs.existsSync(f))fs.copyFileSync(f,path.join('public',f));}\"",
    "pretest": "npm run sync:public",
    "predeploy": "npm run sync:public",
    "start": "node server.js",
    "test": "node tests/run_all_tests.js",
    "test:audit": "node tests/run_extended_audit_tests.js",
    "test:ci": "node tests/run_all_tests.js && node tests/run_extended_audit_tests.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ehs",
    "permit-to-work",
    "ptw",
    "construction-safety",
    "safety-governance",
    "finite-state-machine",
    "rbac",
    "dpdp-act-2023",
    "jspdf"
  ],
  "author": "Mohith, Prasanna, Abigna",
  "license": "MIT"
}
