rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================================
    // ARPL EHS PERMIT-TO-WORK -- HARDENED CLOUD STORAGE SECURITY RULES
    // Prohibits executable/scriptable files (SVG, HTML, JS) to eliminate Stored XSS
    // Enforces project-scoped access and strict byte size limits
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'super-admin' ||
        request.auth.token.email == 'aic1176@aurogroup.com'
      );
    }

    function hasProjectAccess(projectId) {
      return isSuperAdmin() ||
        (isAuthenticated() && request.auth.token.projectId == projectId) ||
        (isAuthenticated() && ('projectIds' in request.auth.token) && projectId in request.auth.token.projectIds) ||
        (isAuthenticated() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)));
    }

    function isValidImageContentType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'
      ];
    }

    // Permit Uploads (Site Photos, Drawings, Checklist Docs, Evidence <= 5MB images / <= 15MB PDFs)
    match /permits/{projectId}/{permitId}/{allPaths=**} {
      allow read: if hasProjectAccess(projectId);
      allow create, update: if hasProjectAccess(projectId)
                            && ((isValidImageContentType() && request.resource.size <= 5 * 1024 * 1024)
                            || (request.resource.contentType == 'application/pdf' && request.resource.size <= 15 * 1024 * 1024));
      allow delete: if isSuperAdmin();
    }

    // Temporary Field & Inspection Images (Targeted by 24h GCS Lifecycle Auto-Deletion)
    // Strictly whitelisted to raster image types (BLOCKS SVG to eliminate Stored XSS risks)
    match /temp-images/{projectId}/{permitId}/{imageId} {
      allow read: if hasProjectAccess(projectId);
      allow create: if hasProjectAccess(projectId)
                    && request.resource.size < 10 * 1024 * 1024
                    && isValidImageContentType();
      allow update, delete: if false; // Auto-deleted by GCS lifecycle after 24 hours
    }

    // Digital Signatures for Permits (Strictly PNG or WebP raster signatures <= 512KB)
    match /signatures/{projectId}/{permitId}/{signatureId} {
      allow read: if isAuthenticated() && hasProjectAccess(projectId);
      allow create: if hasProjectAccess(projectId)
                    && request.resource.size < 512 * 1024
                    && request.resource.contentType in ['image/png', 'image/webp'];
      allow update, delete: if false;
    }

    // Direct User Signature Path (readable across approvers & PDF generator)
    match /signatures/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                            && request.auth.uid == userId
                            && request.resource.size < 512 * 1024
                            && request.resource.contentType in ['image/png', 'image/webp'];
      allow delete: if isSuperAdmin();
    }

    // Personnel Profile Signatures (Saved during user empanelment/profile edit <= 512KB)
    match /signatures/{projectId}/users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if hasProjectAccess(projectId)
                    && request.resource.size < 512 * 1024
                    && request.resource.contentType in ['image/png', 'image/webp'];
      allow delete: if isSuperAdmin() || hasProjectAccess(projectId);
    }

    // Statutory Permanent PDFs
    // Strictly blocked from direct bucket read/write; served only via single-use download Cloud Function
    match /statutory-pdfs/{projectId}/{permitId}/{fileName} {
      allow read, write: if false;
    }

    // Explicit Default-Deny Fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

